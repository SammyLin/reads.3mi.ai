---
const year = new Date().getFullYear();
// 與其他 3mi 站共用的頁尾(參考 putguard SiteFooter),lucide 沒有品牌圖示所以自帶 path
const social = [
  { href: 'https://github.com/sammylin', label: 'GitHub', path: 'M12 .297a12 12 0 0 0-3.79 23.39c.6.111.82-.26.82-.578v-2.234c-3.338.726-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.083-.73.083-.73 1.205.084 1.84 1.237 1.84 1.237 1.07 1.835 2.807 1.305 3.492.998.108-.776.42-1.305.762-1.605-2.665-.3-5.467-1.332-5.467-5.93 0-1.31.468-2.38 1.235-3.22-.123-.303-.535-1.523.117-3.176 0 0 1.008-.322 3.3 1.23A11.5 11.5 0 0 1 12 5.8c1.02.005 2.047.138 3.006.404 2.29-1.552 3.297-1.23 3.297-1.23.653 1.653.241 2.873.118 3.176.77.84 1.233 1.91 1.233 3.22 0 4.61-2.806 5.625-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .32.218.694.825.576A12 12 0 0 0 12 .297z' },
  { href: 'https://linkedin.com/in/sammylintw', label: 'LinkedIn', path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z' },
  { href: 'https://x.com/sammylintw', label: 'X', path: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z' },
];
const products = [
  { href: 'https://3mi.ai', label: '3mi.ai' },
  { href: 'https://reads.3mi.ai', label: 'Reads' },
  { href: 'https://trending.3mi.ai', label: 'Trending' },
  { href: 'https://chunkup.3mi.ai', label: 'ChunkUp' },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="subscribe-box">
      <div>
        <strong>訂閱電子報</strong>
        <p>新文章與工程判讀,直接寄到你的信箱。</p>
      </div>
      <form class="subscribe-form" data-source="footer">
        <input type="email" name="email" placeholder="you@example.com" required maxlength="254" autocomplete="email">
        <input type="text" name="website" class="subscribe-hp" tabindex="-1" autocomplete="off" aria-hidden="true">
        <button type="submit" class="btn btn-primary">訂閱</button>
      </form>
    </div>
    <div class="foot-row">
      <span>由 Sammy Lin 製作 · <a href="https://3mi.ai" target="_blank" rel="noopener" class="strong">3mi.ai</a></span>
      <div class="foot-social">
        {social.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
          </a>
        ))}
      </div>
    </div>
    <div class="foot-more">
      <span>其他作品</span>
      {products.map((p) => <a href={p.href} target="_blank" rel="noopener">{p.label}</a>)}
      <span class="foot-copy">© {year} Sammy Lin</span>
    </div>
  </div>
</footer>

<script>
// 事件委派：接住全站所有 .subscribe-form（含文章頁 runtime 注入的）
document.addEventListener('submit', async (e) => {
  const form = (e.target as HTMLElement)?.closest?.('.subscribe-form') as HTMLFormElement | null;
  if (!form) return;
  e.preventDefault();

  const emailInput = form.querySelector('input[name="email"]') as HTMLInputElement;
  const honeypot = form.querySelector('input[name="website"]') as HTMLInputElement;
  const button = form.querySelector('button') as HTMLButtonElement;
  button.disabled = true;
  button.textContent = '送出中...';

  try {
    const res = await fetch('/api/subscribe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email: emailInput.value,
        website: honeypot?.value || '',
        source: form.dataset.source || location.pathname,
      }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || '訂閱失敗');
    form.outerHTML = '<p class="subscribe-done">已訂閱,之後有新內容會寄給你。</p>';
  } catch (err: any) {
    button.disabled = false;
    button.textContent = '訂閱';
    let msg = form.querySelector('.subscribe-error') as HTMLElement;
    if (!msg) {
      msg = document.createElement('p');
      msg.className = 'subscribe-error';
      form.appendChild(msg);
    }
    msg.textContent = err.message;
  }
});
</script>
